# Full end-to-end test input deck for
# tests/core/testClusterSpecsynFull.cpp: drives a complete run through
# SimCluster using the real MIST tracks and the real POWR_WC/POWR_WNE/
# POWR_WNL/TLUSTY_O/TLUSTY_B/BOSZ/CK04/MARCS spectral libraries (not
# the small test fixtures used elsewhere), so this only runs if that
# data -- too large to store in the repository -- has been fetched
# locally (see data/tools/fetch_mist.py, fetch_powr.py, fetch_tlusty.py,
# fetch_bosz.py, fetch_ck04.py, fetch_marcs.py). spectra.model lists
# TLUSTY_O and TLUSTY_B separately, rather than a single combined
# TLUSTY entry, since fetch_tlusty.py now fetches PoWR's O-star and
# B-star grids (different recommended default microturbulent
# velocities) into separate registry entries; together they span
# 15000-55000 K, closing the 16000-27500 K gap this test originally
# found between BOSZ and the old single TLUSTY grid. CK04 is listed
# after BOSZ since it exists specifically to catch stars in BOSZ's own
# gaps -- BOSZ has essentially no models for Teff >~ 8000 K combined
# with log g <~ 1.5, a real hole this test also found, which CK04 (a
# fully rectangular grid through that same region) fills. MARCS is
# listed last, after CK04, to extend coverage down to cooler Teff
# (2500 K, versus CK04's 3500 K floor) for red-supergiant-phase stars;
# it does not extend log(g) coverage below BOSZ's own -0.5 floor
# (MARCS's own published grid floors at exactly the same value), so
# closing that remaining gap relies on SpecsynLibChained's tClamp
# clamp of log(g) (and, separately, log(Teff)) into whatever the
# chain actually covers -- see SpecsynLibChained's own constructor
# comment. Output times span 2-10 Myr to capture stellar evolution
# before, during, and after the Wolf-Rayet phase.
#
# FeH uses a flat distribution from -1 to 0 (see
# testClusterSpecsynFullFeHDist.toml). This was previously pinned to
# a delta function at 0.0 because MIST's feh=-0.50 (afe=0.0,
# v_vcrit=0.4) group was short two masses (1.95 and 2.00 Msun), and
# Tracks3D requires every bracketed [Fe/H] group to share an identical
# mass grid. The missing tracks have since been filled by
# data/tools/interpolate_mist.py.

sim_type = "cluster"
# n_trial must appear here, before any [table] header -- TOML has no
# way to return to the root table once a header opens one, so a bare
# key placed after e.g. [outputs] below would silently become
# outputs.n_trial instead of the top-level key SimControls actually
# reads. (Exactly this mistake previously left every run of this test
# at the n_trial=1 default without erroring, since every earlier run
# failed on a spectral-synthesis gap before the trial count ever
# mattered.)
n_trial = 10

[stars]
IMF = "chabrier.toml"
tracks = "MIST"
v_vcrit = 0.4
alphaFe = 0.0
FeH = "tests/core/assets/testClusterSpecsynFullFeHDist.toml"

[spectra]
model = ["POWR_WC", "POWR_WNE", "POWR_WNL", "TLUSTY_O", "TLUSTY_B", "BOSZ", "CK04", "MARCS"]
# Rebins every chained library from its own native wavelength grid
# down to 2048 points, spanning the same native range (wl_min/wl_max
# are left unsupplied, so each library falls back to its own native
# range -- see SpecsynLibNoWind/SpecsynLibWR's own "nWl alone"
# handling), cutting this test's spectral resolution -- and so its
# runtime -- by roughly a factor of 4 without changing what physical
# regime it actually exercises.
nwl = 2048

[clusters]
CMF = 1e4

[outputs]
output_times = [2e6, 3e6, 4e6, 1e7]
