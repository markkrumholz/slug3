# Full end-to-end test input deck for
# tests/core/testClusterSpecsynFull.cpp: drives a complete run through
# SimCluster using the real MIST tracks and the real POWR_WC/POWR_WNE/
# POWR_WNL_H20/POWR_WNL_H40/POWR_WNL_H60/TLUSTY_O/TLUSTY_B/BOSZ/CK04/
# MARCS/TREMBLAY_DA/TREMBLAY_ELM spectral libraries (not the small test
# fixtures used elsewhere), so this only runs if that data -- too
# large to store in the repository -- has been fetched locally (see
# data/tools/tracks/fetch_mist.py and data/tools/spectra/fetch_powr.py,
# fetch_tlusty.py, fetch_bosz.py, fetch_ck04.py, fetch_marcs.py,
# fetch_tremblay.py).
# spectra.model is the special value "default" (see
# specsyn::defaultModelList and SimControls::readSpectra()), which
# expands to exactly this same chained list, in this same order;
# spelled out here for reference, since the order matters:
#   - POWR_WNL_H20/H40/H60 are listed separately, rather than a single
#     combined WNL entry, since fetch_powr.py now splits PoWR's WNL
#     grids by surface hydrogen mass fraction into separate registry
#     entries, one per WRType::WNLH20/WNLH40/WNLH60 (see
#     SpecsynLibWR::getWRType)
#   - TLUSTY_O and TLUSTY_B are listed separately, rather than a single
#     combined TLUSTY entry, since fetch_tlusty.py now fetches PoWR's
#     O-star and B-star grids (different recommended default
#     microturbulent velocities) into separate registry entries;
#     together they span 15000-55000 K, closing the 16000-27500 K gap
#     this test originally found between BOSZ and the old single
#     TLUSTY grid
#   - CK04 is listed after BOSZ since it exists specifically to catch
#     stars in BOSZ's own gaps -- BOSZ has essentially no models for
#     Teff >~ 8000 K combined with log g <~ 1.5, a real hole this test
#     also found, which CK04 (a fully rectangular grid through that
#     same region) fills
#   - MARCS is listed after CK04, to extend coverage down to cooler
#     Teff (2500 K, versus CK04's 3500 K floor) for red-supergiant-
#     phase stars; it does not extend log(g) coverage below BOSZ's own
#     -0.5 floor (MARCS's own published grid floors at exactly the
#     same value), so closing that remaining gap relies on
#     SpecsynLibChained's tClamp clamp of log(g) (and, separately,
#     log(Teff)) into whatever the chain actually covers -- see
#     SpecsynLibChained's own constructor comment
#   - TREMBLAY_DA and TREMBLAY_ELM are listed last, after every
#     ordinary (non-degenerate) atmosphere library, since white dwarfs
#     -- log(g) ~ 7-9.5 -- are outside every library above's own
#     log(g) coverage entirely; TREMBLAY_DA (Teff up to 140000 K)
#     before TREMBLAY_ELM (Teff only up to 40000 K) so the hottest
#     young white dwarfs still resolve to DA rather than ELM's own
#     final OOBPolicy::raise -- see specsyn::defaultModelList's own
#     comment for the full rationale
# Output times span 2 Myr-10 Gyr: 2-10 Myr to capture stellar
# evolution before, during, and after the Wolf-Rayet phase, and
# 1e8-1e10 yr to exercise the TREMBLAY_DA/TREMBLAY_ELM coverage added
# above -- MIST evolves progressively lower-mass (and so longer-lived)
# stars onto the white dwarf cooling track as a population ages, so
# these later times are where white dwarfs actually start appearing at
# a non-negligible fraction of the population's stochastically-sampled
# stars.
#
# FeH uses a flat distribution from -1 to 0 (see
# testClusterSpecsynFullFeHDist.toml). This was previously pinned to
# a delta function at 0.0 because MIST's feh=-0.50 (afe=0.0,
# v_vcrit=0.4) group was short two masses (1.95 and 2.00 Msun), and
# Tracks3D requires every bracketed [Fe/H] group to share an identical
# mass grid. The missing tracks have since been filled by
# data/tools/tracks/interpolate_mist.py.

sim_type = "cluster"
# n_trial must appear here, before any [table] header -- TOML has no
# way to return to the root table once a header opens one, so a bare
# key placed after e.g. [output] below would silently become
# output.n_trial instead of the top-level key SimControls actually
# reads. (Exactly this mistake previously left every run of this test
# at the n_trial=1 default without erroring, since every earlier run
# failed on a spectral-synthesis gap before the trial count ever
# mattered.)
n_trial = 10

[stars]
IMF = "chabrier.toml"
tracks = "MIST"
v_vcrit = 0.4
alphaFe = 0.0
FeH = "tests/core/assets/testClusterSpecsynFullFeHDist.toml"

[spectra]
model = "default"
# Rebins every chained library from its own native wavelength grid
# down to 2048 points, spanning the same native range (wl_min/wl_max
# are left unsupplied, so each library falls back to its own native
# range -- see SpecsynLibNoWind/SpecsynLibWR's own "nWl alone"
# handling), cutting this test's spectral resolution -- and so its
# runtime -- by roughly a factor of 4 without changing what physical
# regime it actually exercises.
nwl = 2048

# Exercises the full photometry pipeline against a real, chained
# spectrum: two idealized ionizing-photon-count filters (Q(HI),
# Q(HeI), Q(OII)), three real tabulated filters spanning optical to
# mid-infrared (registry/vega both default to the real data/filters
# and data/spectra/vega.h5 fetched locally -- see
# testClusterSpecsynFullCommon.cpp's own allPhotDataFilesExist()), one
# idealized energy-flux filter, all reported as Vega magnitudes
# (except the two photon-count filters, for which PhotSystem doesn't
# apply), and "Lbol" -- exercising Cluster::computeLbol() against a
# real, non-trivial (both stochastic and continuously-sampled, since
# stars.min_stoch_mass is unset here so the whole population is drawn
# stochastically -- see testClusterSpecsynFullNonStoch's own deck for
# the fully continuous counterpart) population.
[phot]
filters = ["Q(HI)", "Q(HeI)", "Q(OII)", "HST.ACS_WFC.F435W", "HST.ACS_WFC.F606W", "JWST.MIRI.F770W", "ideal_energy_1000_5000", "Lbol"]
system = "Vega"

[clusters]
CMF = 1e4

[output]
output_times = [2e6, 3e6, 4e6, 1e7, 1e8, 1e9, 1e10]

[nebular]
compute_neb = false
