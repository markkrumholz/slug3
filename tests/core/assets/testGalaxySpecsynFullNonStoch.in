# Full end-to-end test input deck for
# tests/core/testGalaxySpecsynFullNonStoch.cpp: the Galaxy counterpart
# to tests/core/assets/testClusterSpecsynFullNonStoch.in (see that
# file's own comments for the shared rationale behind spectra.model,
# nwl, and the FeH distribution), except sim_type is "galaxy" rather
# than "cluster", clusters.f_cluster = 0.0 (rather than left at its
# default of 1.0) drives the entire stellar population through
# Galaxy::computeSpec()'s continuously-treated (Specsyn::specAndLbolCts())
# path -- exercising the joint (time, feh, mass) PDFIntegratorND
# integral over a galaxy's full star formation history, not just a
# single mono-age population like Cluster::computeSpec()'s own
# specCts() -- and stars.min_stoch_mass is omitted entirely, since it
# has no effect at all when f_cluster is already 0 (no star ever gets
# drawn into an individual Cluster to begin with, stochastically
# sampled or not). galaxy.sfr is a new addition with no cluster-type
# counterpart -- a plain, round 1 Msun/yr, which by the last output
# time (1e10 yr) works out to a total galaxy-scale stellar mass
# comparable to a real galaxy's, though the exact value has little
# effect on this integral's own computational cost (dominated by the
# age/mass domain's own complexity, not by the absolute star formation
# rate).
#
# clusters.CMF/CLF are still required (SimControls parses them
# unconditionally for a galaxy-type sim, regardless of f_cluster), but
# -- with f_cluster = 0 -- are never actually drawn from, so their
# exact values (matching the original cluster-type test's own CMF,
# a delta function at 1e4 Msun; CLF borrowed from
# testGalaxyDynamics.in's own, a delta function at 5e5 yr) are
# immaterial here.
#
# Uses the same output_times as testClusterSpecsynFullNonStoch.in --
# see runGalaxySpecsynFull's own comment for how this is temporarily
# overridden (via a separate scratch deck, not this one) for the
# integration-strategy timing comparison.

sim_type = "galaxy"
n_trial = 1

[stars]
IMF = "chabrier.toml"
tracks = "MIST"
v_vcrit = 0.4
alphaFe = 0.0
FeH = "tests/core/assets/testClusterSpecsynFullFeHDist.toml"

[spectra]
model = "default"
nwl = 1024
wl_min = 500
wl_max = 1e4

[clusters]
CMF = 1e4
CLF = 5e5
f_cluster = 0.0

[galaxy]
sfr = 1.0

[output]
output_times = [2e6, 3e6, 4e6, 1e7, 1e8, 1e9, 1e10]
