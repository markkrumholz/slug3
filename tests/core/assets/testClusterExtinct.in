# Test input deck for a cluster simulation with dust extinction enabled --
# otherwise identical to testClusterPhot.in

sim_type = "cluster"

[stars]
IMF = "chabrier.toml"
track_registry = "tests/tracks/assets/tracks.toml"
tracks = "MIST_test"
FeH = 0.0
alphaFe = -0.2

[spectra]
model = "blackbody"

[phot]
filters = ["SLUGTEST.CAM1.G500", "ideal_phot_700_1500", "Lbol"]
registry = "tests/phot/assets/filters_test.toml"

[extinct]
AV = 1.0
model = "Calzetti_starburst"

[clusters]
CMF = 1e3

[output]
start_time = 0.0
end_time = 10.0
ntime = 3
