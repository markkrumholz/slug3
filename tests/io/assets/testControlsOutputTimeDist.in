# Test input deck for SimControls: output.output_times, given a single
# scalar value, drawing every trial's output time from a delta-function
# PDF (option 1's PDF interpretation)

sim_type = "cluster"

[stars]
IMF = "chabrier.toml"
track_registry = "tests/tracks/assets/tracks.toml"
tracks = "MIST_test"
FeH = 0.0
alphaFe = -0.2

[clusters]
CMF = 1e3

[output]
output_times = 5.0

[nebular]
compute_neb = false
