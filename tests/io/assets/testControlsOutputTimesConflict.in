# Test input deck for SimControls: both output.output_times and the
# output.start_time/end_time/ntime range specified at once (invalid --
# only one option may be given)

sim_type = "cluster"

[stars]
IMF = "chabrier.toml"
track_registry = "tests/tracks/assets/tracks.toml"
tracks = "MIST_test"
FeH = 0.0
alphaFe = -0.2

[clusters]
CMF = 1e3

[output]
output_times = [1.0, 2.0]
start_time = 0.0
end_time = 10.0
ntime = 3

[nebular]
compute_neb = false
